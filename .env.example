VITE_FIREBASE_API_KEY=
# Use the Firebase Auth domain from Project settings, usually:
# <project-id>.firebaseapp.com
# Do not set this to localhost, 127.0.0.1, or a URL with http/port.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Spendr AI (Gemini) ─────────────────────────────────────────────────────
# Note: AI features now securely connect through the backend proxy.
# Do not place any Gemini API keys here.
# VITE_GEMINI_MODEL=gemini-1.5-flash-latest
# Comma-separated fallbacks if primary returns 404
# VITE_GEMINI_FALLBACK_MODELS=gemini-1.5-flash,gemini-1.5-flash-8b
# VITE_GEMINI_TIMEOUT_MS=45000
# VITE_GEMINI_CACHE_TTL_MS=600000
# VITE_GEMINI_THROTTLE_MS=60000
# VITE_GEMINI_TEMPERATURE=0.4
# VITE_GEMINI_RETRY_MAX=3
# VITE_GEMINI_DEV_MOCK=true
# VITE_AI_ENABLED=true
