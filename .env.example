# ─── Firebase Frontend Configuration ──────────────────────────────────────────
VITE_FIREBASE_API_KEY=
# Use the Firebase Auth domain from Project settings, usually:
# <project-id>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Firebase Functions Backend Configuration ────────────────────────────────
# These variables should be set in Firebase Secrets or backend/functions/.env
# when running locally.

# Used for Google Cloud Vertex AI access inside Firebase Functions
GOOGLE_APPLICATION_CREDENTIALS=

# Used for the getPersonalizedFeed News API
NEWS_API_KEY=

# Used by the logReward function to prevent client-side farming
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Local Development Fallbacks ─────────────────────────────────────────────
# If you are running locally without the Firebase backend emulator, 
# you can provide a raw Gemini API key for the frontend chatService fallback:
VITE_GEMINI_API_KEY=

