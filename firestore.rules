rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profile: users/{auth.uid}
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow write: if isOwner(userId);

      // User-owned transactions: users/{uid}/transactions/{id}
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }
      
      // User-owned savings challenges: users/{uid}/savings_challenges/{id}
      match /savings_challenges/{challengeId} {
        allow read, write: if isOwner(userId);
      }

      // Gamification & Rewards
      match /achievements/{achievementId} {
        allow read, write: if isOwner(userId);
      }
      match /financial_levels/{document} {
        allow read, write: if isOwner(userId);
      }
      match /rewards/{rewardId} {
        allow read, write: if isOwner(userId);
      }

      // User-owned notifications: users/{uid}/notifications/{id}
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }

      // User subscription: users/{uid}/subscription/current
      match /subscription/{document} {
        allow read, write: if isOwner(userId);
      }

      // User-owned AI reports: users/{uid}/ai_reports/{id}
      match /ai_reports/{reportId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // User-owned emotional spending intelligence: users/{uid}/emotional_insights/{id}
      match /emotional_insights/{insightId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // User-owned personality: users/{uid}/personality/{id}
      match /personality/{document=**} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // User-owned support requests: users/{uid}/support_requests/{id}
      match /support_requests/{requestId} {
        allow create: if isOwner(userId);
        allow read: if isOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
