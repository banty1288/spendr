rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Prevents privilege escalation and tampering with protected fields
    function safeUserUpdate() {
      let data = request.resource.data;
      let oldData = resource == null ? {} : resource.data;
      
      // Fields that ONLY a backend admin/function can modify
      return (data.get('isPro', null) == oldData.get('isPro', null)) &&
             (data.get('subscription', null) == oldData.get('subscription', null)) &&
             (data.get('totalPoints', null) == oldData.get('totalPoints', null)) &&
             (data.get('badges', null) == oldData.get('badges', null)) &&
             (data.get('achievements', null) == oldData.get('achievements', null));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && safeUserUpdate();
      allow update: if isOwner(userId) && safeUserUpdate();
      // Only allow delete if they want to delete their account
      allow delete: if isOwner(userId);

      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }
      
      match /savings_challenges/{challengeId} {
        allow read, write: if isOwner(userId);
      }

      // Gamification (These should ideally be read-only for clients, but we allow safe writes if needed, 
      // however the parent document's fields are locked)
      match /achievements/{achievementId} {
        allow read: if isOwner(userId);
        // If gamification is fully backend-driven, write should be false.
        // We'll leave write open here since the subcollection items themselves might just be read receipts
        allow write: if isOwner(userId);
      }
      match /financial_levels/{document} {
        allow read, write: if isOwner(userId);
      }
      match /rewards/{rewardId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }

      // Subscription details MUST be strictly read-only for clients!
      match /subscription/{document} {
        allow read: if isOwner(userId);
        allow write: if false; // ONLY BACKEND CAN WRITE SUBSCRIPTIONS
      }

      match /ai_reports/{reportId} {
        allow read, write: if isOwner(userId);
      }

      match /emotional_insights/{insightId} {
        allow read, write: if isOwner(userId);
      }

      match /personality/{document=**} {
        allow read, write: if isOwner(userId);
      }

      match /support_requests/{requestId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
